generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  // Uses the same UUID as Supabase Auth auth.users.id.
  id    String  @id @db.Uuid
  email String  @unique
  name  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships            CompanyMembership[]
  sentInvitations        Invitation[]        @relation("InvitationInviter")
  receivedNotifications  Notification[]      @relation("NotificationRecipient")
  triggeredNotifications Notification[]      @relation("NotificationActor")
}

model Company {
  id                 String  @id @default(uuid()) @db.Uuid
  name               String
  legalName          String?
  slug               String  @unique
  countryCode        String
  registrationNumber String?
  industry           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships  CompanyMembership[]
  invitations  Invitation[]
  notifications Notification[]
}

model CompanyMembership {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  companyId String @db.Uuid

  role String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

model Invitation {
  id           String           @id @default(uuid()) @db.Uuid
  companyId    String           @db.Uuid
  inviterId    String           @db.Uuid
  invitedEmail String
  role         String
  tokenHash    String           @unique
  expiresAt    DateTime
  status       InvitationStatus @default(PENDING)
  acceptedAt   DateTime?
  declinedAt   DateTime?
  revokedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inviter User    @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([companyId, invitedEmail])
  @@index([inviterId, createdAt])
  @@index([expiresAt])
}

model Notification {
  id          String   @id @default(uuid()) @db.Uuid
  recipientId String   @db.Uuid
  companyId   String?  @db.Uuid
  actorType   String   @default("SYSTEM")
  actorId     String?  @db.Uuid
  type        String
  title       String
  message     String
  link        String?
  readAt      DateTime?
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipient User     @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  actor     User?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt, id])
  @@index([recipientId, companyId, createdAt])
  @@index([recipientId, type])
}
