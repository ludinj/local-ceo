generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  // Uses the same UUID as Supabase Auth auth.users.id.
  // The application does not generate a separate user ID.
  id    String  @id @db.Uuid
  email String  @unique
  name  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships CompanyMembership[]
}

model Company {
  id   String @id @default(uuid()) @db.Uuid
  name String
  slug String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships CompanyMembership[]
}

model CompanyMembership {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  companyId String @db.Uuid

  // Kept as a string during Phase 3.
  // RBAC and the final role model will be defined in Phase 4.
  role String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // A user can only have one membership per company.
  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
}
